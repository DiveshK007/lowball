// LOWBALL — sealed-bid mystery drop.
//
// Multi-drop: one deployment carries many drops, keyed by a Bytes<32> drop id
// (the slug, UTF-8, zero-padded — see src/drop-id.ts). This reverses the L1
// single-drop shortcut; see decisions log §10 and
// docs/superpowers/plans/2026-09-12-multi-drop.md.
//
// Still deferred (see docs/spikes/): no in-circuit deadline, no shielded
// escrow, no admin gate, and only the latest bid per drop can be opened.

pragma language_version >= 0.20;

import CompactStandardLibrary;

export enum DropStatus {
  UNSET,
  OPEN,
  REVEALED
}

// Public ledger state (see docs/architecture.md §3.1), one entry per drop.
//
// Deliberately flattened into sibling maps rather than one Map<DropId, struct>.
// A struct value would force a read-modify-write of the whole record on every
// bid, and a Cell read commits the transaction to the field's current value —
// so two bidders in the same block would collide. Counter.increment carries no
// such constraint, which is what makes concurrent bidding safe.
export ledger dropStatus: Map<Bytes<32>, DropStatus>;
export ledger dropCommitment: Map<Bytes<32>, Bytes<32>>;
export ledger dropStock: Map<Bytes<32>, Uint<32>>;
export ledger dropCloseTime: Map<Bytes<32>, Uint<64>>;
export ledger dropMetaRef: Map<Bytes<32>, Opaque<"string">>;
export ledger dropBidCount: Map<Bytes<32>, Counter>;
export ledger dropLatestBid: Map<Bytes<32>, Bytes<32>>;
export ledger dropRevealed: Map<Bytes<32>, Uint<64>>;
export ledger dropWinnerFound: Map<Bytes<32>, Boolean>;
export ledger dropCount: Counter;

// Private witnesses (see docs/architecture.md §3.1)
witness bidAmountWitness(): Uint<64>;
witness bidderSecretWitness(): Bytes<32>;
witness reserveWitness(): Uint<64>;
witness saltWitness(): Bytes<32>;

// Domain-separated hash of (bidAmount, bidderSecret) for a bid.
// Exported so ops + tests can compute the same commitment.
export circuit bidHash(amount: Uint<64>, secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "lowball:bid:v1"),
    secret,
    amount as Field as Bytes<32>
  ]);
}

// Domain-separated hash of (reserve, salt) for the sealed reserve.
// Exported so ops (create-drop) can pre-compute the commitment offline.
export circuit reserveHash(reserve: Uint<64>, salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "lowball:reserve:v1"),
    salt,
    reserve as Field as Bytes<32>
  ]);
}

// createDrop: publish one drop's sealed reserve commitment + config.
// Ids are unique for the contract's lifetime; re-using one is rejected rather
// than silently overwriting a live drop's commitment.
export circuit createDrop(
  dropId_: Bytes<32>,
  commitment_: Bytes<32>,
  stock_: Uint<32>,
  closeTime_: Uint<64>,
  metaRef_: Opaque<"string">
): [] {
  const dropId = disclose(dropId_);
  assert(!dropStatus.member(dropId), "drop already exists");
  dropCommitment.insert(dropId, disclose(commitment_));
  dropStock.insert(dropId, disclose(stock_));
  dropCloseTime.insert(dropId, disclose(closeTime_));
  dropMetaRef.insert(dropId, disclose(metaRef_));
  // Nested ledger values must be initialised before first use.
  dropBidCount.insert(dropId, default<Counter>);
  dropStatus.insert(dropId, DropStatus.OPEN);
  dropCount.increment(1);
}

// placeBid: seal a bid as a commitment against one drop. Verdict deferred to
// checkWin per spec §10 (L1 uses spec §3.4 fallback funds path).
export circuit placeBid(dropId_: Bytes<32>): [] {
  const dropId = disclose(dropId_);
  assert(dropStatus.member(dropId), "no such drop");
  assert(dropStatus.lookup(dropId) == DropStatus.OPEN, "drop not open");
  dropLatestBid.insert(
    dropId,
    disclose(bidHash(bidAmountWitness(), bidderSecretWitness()))
  );
  dropBidCount.lookup(dropId).increment(1);
}

// revealReserve: hash the (reserve, salt) witnesses and assert they match the
// commitment published for this drop. Tampered reveals fail the assert, and
// every other drop is untouched.
export circuit revealReserve(dropId_: Bytes<32>): [] {
  const dropId = disclose(dropId_);
  assert(dropStatus.member(dropId), "no such drop");
  assert(dropStatus.lookup(dropId) == DropStatus.OPEN, "drop not open");
  const reserve = reserveWitness();
  assert(
    reserveHash(reserve, saltWitness()) == dropCommitment.lookup(dropId),
    "reveal does not match commitment"
  );
  dropRevealed.insert(dropId, disclose(reserve));
  dropStatus.insert(dropId, DropStatus.REVEALED);
}

// checkWin: post-reveal verdict for one drop. The bidder proves they placed the
// commitment recorded against that drop and that its amount clears that drop's
// revealed reserve. On LOSS the assert fails and nothing is disclosed.
export circuit checkWin(dropId_: Bytes<32>): [] {
  const dropId = disclose(dropId_);
  assert(dropStatus.member(dropId), "no such drop");
  assert(
    dropStatus.lookup(dropId) == DropStatus.REVEALED,
    "reserve not yet revealed"
  );
  assert(dropLatestBid.member(dropId), "no bid recorded for this drop");
  const amount = bidAmountWitness();
  assert(
    bidHash(amount, bidderSecretWitness()) == dropLatestBid.lookup(dropId),
    "bid preimage mismatch"
  );
  assert(amount >= dropRevealed.lookup(dropId), "bid below reserve");
  dropWinnerFound.insert(dropId, true);
}
