# LOWBALL web — copy to .env.local to override the built-in defaults.
# (No .env is committed; `*.env` is git-ignored.)
# Every value has a Preprod default in src/config/index.ts; only
# VITE_CONTRACT_ADDRESS is genuinely required to bid.

# Deployed LOWBALL contract address (from `npm run deploy:preprod` in contract/).
# Leave empty to use the Preprod default baked into src/config/index.ts.
VITE_CONTRACT_ADDRESS=

# Midnight network the app targets. Must match the network selected in Lace.
VITE_NETWORK_ID=preprod

# Chain read path. Used without a wallet (gallery, receipts).
VITE_INDEXER_URI=https://indexer.preprod.midnight.network/api/v3/graphql
VITE_INDEXER_WS_URI=wss://indexer.preprod.midnight.network/api/v3/graphql/ws

# Fallback proof server. Lace's own configured prover wins when connected.
VITE_PROOF_SERVER_URI=http://127.0.0.1:6300
