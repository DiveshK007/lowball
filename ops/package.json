{
  "name": "@lowball/ops",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "lowball": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "derive-address": "tsx src/derive-address.ts",
    "sync:contract": "rm -rf managed && mkdir -p managed && cp -R ../contract/src/managed/lowball managed/lowball"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/pino": "^7.0.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "@midnight-ntwrk/ledger-v8": "8.0.3",
    "@midnight-ntwrk/wallet-sdk-prover-client": "1.2.1",
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/compact-runtime": "0.16.0"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/ledger-v8": "8.0.3",
    "@midnight-ntwrk/midnight-js": "4.0.4",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.0.4",
